{
  "name": "efims-backend",
  "version": "0.1.0",
  "description": "EFIMS backend — NestJS modular monolith",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node -e \"['tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'].forEach(f=>require('fs').rmSync(f,{force:true}))\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "prestart:dev": "node -e \"['tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'].forEach(f=>require('fs').rmSync(f,{force:true}))\"",
    "start:dev": "nest start --watch",
    "prestart:debug": "node -e \"['tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'].forEach(f=>require('fs').rmSync(f,{force:true}))\"",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/e2e/jest-e2e.config.js",
    "test:e2e:coverage": "jest --config test/e2e/jest-e2e.config.js --coverage --collectCoverageFrom=\"src/**/*.ts\"",
    "test:e2e:setup-db": "node -e \"require('dotenv').config({ path: 'test/e2e/.env.test' }); require('child_process').execSync('npx prisma migrate deploy', { stdio: 'inherit', env: process.env });\" && node -e \"require('dotenv').config({ path: 'test/e2e/.env.test' }); require('child_process').execSync('npx prisma db execute --file prisma/rls-policies.sql --schema prisma/schema.prisma', { stdio: 'inherit', env: process.env });\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:rls": "prisma db execute --file prisma/rls-policies.sql --schema prisma/schema.prisma",
    "seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.19.1",
    "argon2": "^0.40.3",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "openai": "^7.55.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "prisma": "^5.19.1",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts"
  }
}
