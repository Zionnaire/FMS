# PostgreSQL connection used by Prisma. The `efims_app` role must NOT be a superuser and
# must NOT have BYPASSRLS — RLS policies are only meaningful against a non-bypassing role.
# See prisma/rls-policies.sql for why.
#
# Any real Postgres works (local, Render, Neon, ...) — this project's own dev/verification pass
# used Neon's free tier. If you're on a pooled connection (PgBouncer — Neon's "-pooler" hostname,
# or equivalent), DIRECT_URL below is required, not optional; see that var's own comment.
DATABASE_URL="postgresql://efims_app:changeme@localhost:5432/efims?schema=public"

# Only needed if DATABASE_URL goes through a connection pooler (PgBouncer). Prisma Migrate needs
# a direct, non-pooled connection for advisory locks — point this at the same database via its
# unpooled host/port, authenticated as the migration-owning role (NOT efims_app, which can't
# create tables or the efims_app role itself — see rls-policies.sql). If DATABASE_URL is already
# a direct connection (e.g. plain local Postgres), set DIRECT_URL to the same value.
DIRECT_URL="postgresql://<migration-owner>:<password>@localhost:5432/efims?schema=public"

# JWT signing secret for access tokens. Generate a real one for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-only-change-me"
JWT_ACCESS_TTL="15m"

# Refresh tokens are opaque random strings, hashed at rest — this secret is only used to
# sign the outer JWT that wraps the refresh token id, not the token's entropy.
JWT_REFRESH_SECRET="dev-only-change-me-too"
JWT_REFRESH_TTL="7d"

PORT=3001

# Comma-separated allow-list of origins the frontend is served from — CORS is never wide open
# (see main.ts). Add every real frontend origin (local dev, staging, production) here.
CORS_ORIGINS="http://localhost:3000"

# Rate limiting (see src/app.module.ts's ThrottlerModule registration). TTL in milliseconds.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Platform/super-admin layer (src/platform/) — deliberately a SEPARATE secret from
# JWT_ACCESS_SECRET above; a platform token and a tenant token must never be interchangeable.
PLATFORM_JWT_SECRET="dev-only-change-me-platform"
PLATFORM_JWT_TTL="1h"

# ml-gateway (src/modules/ml-gateway/) — the ONLY module allowed to call an external AI/ML
# provider (CLAUDE.md non-negotiable #4). Every ml-gateway capability is advisory-only (a
# suggestion a human can accept/reject) — see that module's own doc comment and
# docs/configuration-decisions.md's CD-08.
#
# EFIMS AI Service — the primary engine for severity, anomaly scoring, and recovery prediction.
# Run it yourself per its own README; defaults to localhost. No auth yet (vendor's own doc, v1.0)
# — this backend is the only thing that ever calls it, same "never from the browser" rule as Groq.
ML_SERVICE_BASE_URL="http://127.0.0.1:8000"

# Groq — kept only as (a) an automatic fallback for severity if the EFIMS AI Service is
# unreachable, and (b) the sole engine for duplicate/correlation detection, which the EFIMS AI
# Service doesn't cover at all. Groq's API is OpenAI-compatible; the `openai` SDK is pointed at
# Groq's own base URL rather than OpenAI's. Get a key at https://console.groq.com/keys.
GROQ_API_KEY="dev-only-change-me-groq"
GROQ_MODEL="openai/gpt-oss-120b"

# Web Push (notifications' PUSH channel — src/modules/notifications/) — generate a real pair per
# environment with `npx web-push generate-vapid-keys`; never reuse one across dev/prod. The
# public half also goes to the frontend's NEXT_PUBLIC_VAPID_PUBLIC_KEY (same value, safe to
# expose — that's what "public key" means here). VAPID_SUBJECT is a mailto: or https: URL the
# push service can use to contact you if it needs to (required by the Web Push spec, not optional).
VAPID_PUBLIC_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_SUBJECT="mailto:admin@efims.local"
