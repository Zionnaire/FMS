# Template for test/e2e/.env.test — copy this to .env.test and fill in a DEDICATED test database.
# NEVER point this at the real dev/seed database. See test/e2e/README.md for how this project's
# own `efims_test` database (a separate database on the same Postgres instance as dev) was created.

DATABASE_URL="postgresql://efims_app:<password>@<host>/efims_test?sslmode=require"
DIRECT_URL="postgresql://<owner-role>:<password>@<host>/efims_test?sslmode=require"

JWT_ACCESS_SECRET="test-only-access-secret-not-for-real-use"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="test-only-refresh-secret-not-for-real-use"
JWT_REFRESH_TTL="7d"

PORT=3099
CORS_ORIGINS="http://localhost:3000"

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

PLATFORM_JWT_SECRET="test-only-platform-secret-not-for-real-use"
PLATFORM_JWT_TTL="1h"

GROQ_API_KEY="dev-only-change-me-groq"
GROQ_MODEL="openai/gpt-oss-120b"
